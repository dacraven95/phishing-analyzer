# Generate secure values for API_KEY and MCP_API_TOKEN
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# Copy to .env and set unique strong values. Never commit the populated .env.
API_KEY=

# Optional: leave empty to keep /mcp/ unavailable.
MCP_API_TOKEN=

# Preserve the existing example default. Set true for IOC history/campaigns.
THREAT_INTEL_ENABLED=false

# Leave blank unless a trusted inbound mail gateway sanitizes auth headers.
TRUSTED_AUTH_SERVERS=

CORS_ALLOWED_ORIGINS=

# Keep 0.0.0.0 for external access, or use 127.0.0.1 behind local proxy.
PHISH_BIND_IP=0.0.0.0